# Copiar como .env y completar localmente. NO versionar secretos.

# Supabase PostgreSQL - usar JDBC Session Pooler :5432 para Spring/Hibernate.
# Obtener desde Supabase Dashboard > Connect > JDBC.
# Mantener entre comillas simples para que Compose/source no interpreten caracteres especiales.
SUPABASE_DB_URL='jdbc:postgresql://HOST:5432/postgres?user=USER&password=PASSWORD&sslmode=require'
DB_SCHEMA=aulatrack

# Puertos publicados por Docker Compose para las SPA.
# La API permanece fija en 8080 para mantener cero configuración entre clientes.
REACT_PORT=5173
ANGULAR_PORT=4200
